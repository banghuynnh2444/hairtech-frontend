{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HairTech 3D",
  "version": "0.3.0",
  "identifier": "com.hairtech.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "HairTech 3D",
        "width": 1280,
        "height": 800,
        "minWidth": 1100,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM5RTE4OTEwRTEwMDkwQ0EKUldUS2tBRGhFSW5oeVpKblRMemZOVjBoL3hnc2Q5dFZrMjlwS09IY0F1OGliOEtSeW12RzlJUHgK",
      "endpoints": [
        "https://github.com/banghuynnh2444/hairtech-frontend/releases/latest/download/latest.json"
      ]
    }
  }
}
